        {
          "id": "1dc5b8c7-e2fc-4833-a805-cfa6ae1c63da",
          "name": "Citrix Netscaler Log Out From the Netscaler Appliance",
          "request": {
            "name": "Citrix Netscaler Log Out From the Netscaler Appliance",
            "description": {
              "content": "Terminates the current session and invalidates the NITRO_AUTH_TOKEN cookie.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "config",
                "logout"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The IP address or hostname of the NetScaler appliance (NSIP).",
                  "type": "any",
                  "value": "{{nsip}}",
                  "key": "nsip"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"logout\": \"<object>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "86006d60-1783-4e49-bbe8-ce8ebef89e57",
              "name": "Logout successful.",
              "originalRequest": {
