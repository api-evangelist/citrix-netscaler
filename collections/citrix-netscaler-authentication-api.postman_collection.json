{
  "item": [
    {
      "id": "b56093f0-cbfb-425c-8ea6-cb23ee237c19",
      "name": "Authentication",
      "description": {
        "content": "Session-based authentication for the NITRO API. Obtain an authentication token via login, then include it as a cookie in subsequent requests.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "16866393-1190-4831-9548-a0dfaead7437",
          "name": "Citrix Netscaler Log in to the Netscaler Appliance",
          "request": {
            "name": "Citrix Netscaler Log in to the Netscaler Appliance",
            "description": {
              "content": "Authenticates the user and returns a session token (NITRO_AUTH_TOKEN) as a cookie. This token must be included in subsequent API requests. The default session timeout is 30 minutes, or a user-configured value when restricted timeout is enabled (default 15 minutes).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "config",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The IP address or hostname of the NetScaler appliance (NSIP).",
                  "type": "any",
                  "value": "{{nsip}}",
                  "key": "nsip"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": {\n    \"username\": \"<string>\",\n    \"password\": \"<password>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "f36c1b23-3eb4-4bdc-8bcc-cee13e009508",
              "name": "Login successful. Session token returned as a Set-Cookie header.",
              "originalRequest": {
                "url": {
                  "path": [
                    "config",
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "The IP address or hostname of the NetScaler appliance (NSIP).",
                      "type": "any",
                      "value": "{{nsip}}",
                      "key": "nsip"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "NITRO_AUTH_TOKEN",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"login\": {\n    \"username\": \"nsroot\",\n    \"password\": \"nsroot\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "disabled": false,
                  "description": "NITRO_AUTH_TOKEN cookie for authenticating subsequent requests.",
                  "key": "Set-Cookie",
                  "value": "NITRO_AUTH_TOKEN=abc123xyz; path=/nitro/v1"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"errorcode\": 10,\n  \"message\": \"example_value\",\n  \"severity\": \"NONE\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
            {
