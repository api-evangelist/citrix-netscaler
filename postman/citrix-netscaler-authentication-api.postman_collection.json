  "info": {
    "_postman_id": "ca88a057-0647-4f57-9ec2-eab1743d1cd2",
    "name": "Citrix NetScaler NITRO REST Authentication API",
    "description": "The NITRO (NetScaler Interface Through RESTful Operations) API provides programmatic access to configure, monitor, and manage Citrix NetScaler (ADC) appliances. Built on REST architecture using HTTP/HTTPS, the API supports comprehensive management of application delivery controller features including load balancing virtual servers, content switching virtual servers, system configuration, and appliance-level settings. All NITRO operations are logged to /var/nitro.log on the appliance.\n\nContact Support:\n Name: NetScaler Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:21:15.000Z",
    "updatedAt": "2026-07-28T01:21:15.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-ca88a057-0647-4f57-9ec2-eab1743d1cd2"
  },
